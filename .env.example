# =============================================================================
# .env.example — Global Logistics Platform
# Copy to .env and fill in all values before running.
# =============================================================================

# ── Minio (local S3) ──────────────────────────────────────────────────────
MINIO_ACCESS_KEY=logistics
MINIO_SECRET_KEY=logistics123

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9093,kafka-3:9094

# ── Storage paths ─────────────────────────────────────────────────────────
BRONZE_PATH=s3a://logistics/delta/bronze
SILVER_PATH=s3a://logistics/delta/silver
GOLD_PATH=s3a://logistics/delta/gold
CHECKPOINT_PATH=s3a://logistics/checkpoints

# ── ML ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_STAGE=Production
FEATURE_MAX_AGE_HOURS=2

# ── External APIs (optional) ──────────────────────────────────────────────
OPENWEATHER_API_KEY=
WEATHER_POLL_INTERVAL=900

# ── Airflow ───────────────────────────────────────────────────────────────
AIRFLOW_SECRET_KEY=change-me-in-production

# ── Alerts (optional) ─────────────────────────────────────────────────────
PAGERDUTY_ROUTING_KEY=
